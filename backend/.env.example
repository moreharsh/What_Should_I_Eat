# Required for a live backend (copy this file to backend/.env and fill values).
# This template deliberately contains NO real secrets.
# Used by google-genai for Gemini model requests.
GEMINI_API_KEY=
# Redis is required for demo user sessions, recipe history and caching.
REDIS_URL=

# Optional media enrichment
YOUTUBE_API_KEY=
SPOONACULAR_API_KEY=

# Optional Databricks event/click analytics and admin events tab.
# All three must be set together; ensure the SQL warehouse is running.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_PERSONAL_ACCESS_TOKEN=

# Optional read-only /admin login; must be 16+ characters when enabled.
# The username is fixed to "admin", not configurable.
ADMIN_PASSWORD=

# Optional protected Redis Free-tier activity heartbeat. Set a random 32+ character token.
# Configure the same value as a GitHub Actions secret; do not expose in VITE_*.
REDIS_HEARTBEAT_TOKEN=

# Optional recipe-only Ollama fallback (both URL and model required).
# Use a trusted/restricted reachable server, not an open unauthenticated endpoint.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=20
